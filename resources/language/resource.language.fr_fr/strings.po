msgctxt "#30100"
msgid "Languages"
msgstr "Langues"

msgctxt "#30101"
msgid "Primary Language"
msgstr "Langue principale"

msgctxt "#30102"
msgid "Secondary Language"
msgstr "Langue secondaire"

msgctxt "#30103"
msgid "Third Language"
msgstr "Troisième langue"

msgctxt "#30104"
msgid "Audio Preferences"
msgstr "Préférences audio"

msgctxt "#30105"
msgid "Subtitle Preferences"
msgstr "Préférences des sous-titres"

msgctxt "#30106"
msgid "Conditional Subtitle Preferences"
msgstr "Préférences conditionnelles des sous-titres"

msgctxt "#30107"
msgid "Enable Preference"
msgstr "Activer la préférence"

msgctxt "#30108"
msgid "Enable Language Preference Manager"
msgstr "Activer le gestionnaire de préférences linguistiques"

msgctxt "#30109"
msgid "Pause while evaluating preferences"
msgstr "Mettre en pause pendant l'évaluation des préférences"

msgctxt "#30110"
msgid "If audio language is "
msgstr "Si la langue audio est "

msgctxt "#30111"
msgid "then display subtitles with language"
msgstr "alors afficher les sous-titres avec la langue"

msgctxt "#30112"
msgid "Delay the evaluation by the following value [ms]"
msgstr "Retarder l'évaluation de la valeur suivante [ms]"

msgctxt "#30113"
msgid "Turn on subtitles if a subtitle matches in any setting globally"
msgstr "Activer les sous-titres si une correspondance est trouvée globalement dans n'importe quel paramètre"

msgctxt "#30114"
msgid "Turn off subtitles if no subtitle preference matched"
msgstr "Désactiver les sous-titres si aucune préférence ne correspond"

msgctxt "#30115"
msgid "Advanced/Custom settings"
msgstr "Paramètres avancés/personnalisés"

msgctxt "#30116"
msgid "Try to set the audio and/or subtitle track from the filename first"
msgstr "Essayer d'abord de définir la piste audio et/ou de sous-titres à partir du nom de fichier"

msgctxt "#30117"
msgid "Regular expression for filename based preferences"
msgstr "Expression régulière pour les préférences basées sur le nom de fichier"

msgctxt "#30118"
msgid "Use custom pref, e.g. eng>ger>fin :"
msgstr "Utiliser une préférence personnalisée, ex. eng>ger>fin :"

msgctxt "#30119"
msgid "Use custom pref, e.g. eng>ger>fin :"
msgstr "Utiliser une préférence personnalisée, ex. eng>ger>fin :"

msgctxt "#30120"
msgid "Forced"
msgstr "Forcé"

msgctxt "#30121"
msgid "Use custom pref, e.g. jpn:eng>eng:ger :"
msgstr "Utiliser une préférence personnalisée, ex. jpn:eng>eng:ger :"

msgctxt "#30122"
msgid "General"
msgstr "Général"

msgctxt "#30123"
msgid "Ignore all Signs and Songs subtitles tracks"
msgstr "Ignorer toutes les pistes de sous-titres Signs and Songs"

msgctxt "#30125"
msgid "Enable Subtitle Keyword Blacklist"
msgstr "Activer la liste noire des mots-clés pour les sous-titres"

msgctxt "#30126"
msgid "Enter a comma-separated list of keywords to blacklist in subtitle names"
msgstr "Entrez une liste séparée par des virgules de mots-clés à ajouter à la liste noire dans les noms de sous-titres"

msgctxt "#30127"
msgid "Subtitle Keyword List:"
msgstr "Liste de mots-clés des sous-titres :"

msgctxt "#30128"
msgid "Enable Audio Keyword Blacklist"
msgstr "Activer la liste noire des mots-clés pour l'audio"

msgctxt "#30129"
msgid "Enter a comma-separated list of keywords to blacklist in audio names"
msgstr "Entrez une liste séparée par des virgules de mots-clés à ajouter à la liste noire dans les noms audio"

msgctxt "#30130"
msgid "Audio Keyword List:"
msgstr "Liste de mots-clés audio :"

msgctxt "#30131"
msgid "Fast Subtitles Display:"
msgstr "Affichage rapide des sous-titres :"

msgctxt "#30132"
msgid "Disabled"
msgstr "Désactivé"

msgctxt "#30133"
msgid "New Start only"
msgstr "Nouveaux démarrages uniquement"

msgctxt "#30134"
msgid "Start & Resume"
msgstr "Démarrage et reprise"

msgctxt "#30135"
msgid "Stored Preferences"
msgstr "Préférences stockées"

msgctxt "#30136"
msgid "Store Pref. Movies"
msgstr "Stockage des préférences Films"

msgctxt "#30137"
msgid "Store Pref. TV Shows"
msgstr "Stockage des préférences Séries TV"

msgctxt "#30138"
msgid ""
"Changed audio/subt. override config pref. next time for the same movie/"
"series?"
msgstr ""
"L'audio/modifié des sous-titres remplace les préférences de configuration la prochaine fois pour le même film/la même série ?"

msgctxt "#30139"
msgid ""
"If enabled, manually selected audio/subtitle tracks during playback will be "
"stored and restored next time for the same movie/whole series."
msgstr ""
"S'il est activé, les pistes audio/sous-titres sélectionnées manuellement lors de la lecture seront stockées et restaurées la prochaine fois pour le même film/toute la série."

msgctxt "#30140"
msgid "Edit Overrides"
msgstr "Modifier les remplacements"

msgctxt "#30141"
msgid "A new label"
msgstr "Une nouvelle étiquette"

msgctxt "#30142"
msgid "Enable Audio Original Preferences"
msgstr "Activer les préférences audio originales"

msgctxt "#30143"
msgid "Enter a comma-separated list of codes (e.g eng,ger,fre)"
msgstr "Entrez une liste séparée par des virgules de codes (ex. eng,ger,fre)"

msgctxt "#30144"
msgid "Audio Original Preference List:"
msgstr "Liste des préférences audio originales :"

msgctxt "#30146"
msgid "Use regex pattern to filter subtitles"
msgstr "Utiliser un motif regex pour filtrer les sous-titres"

msgctxt "#30147"
msgid "Regex pattern for subtitle filtering"
msgstr "Motif regex pour le filtrage des sous-titres"

msgctxt "#30148"
msgid "Regex exclusion pattern for subtitle filtering"
msgstr "Motif d'exclusion regex pour le filtrage des sous-titres"

msgctxt "#30149"
msgid "Use regex exclusion pattern to filter out false positives"
msgstr "Utiliser un motif d'exclusion regex pour filtrer les faux positifs"

