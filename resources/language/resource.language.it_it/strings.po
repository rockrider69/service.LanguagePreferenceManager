msgctxt "#30100"
msgid "Languages"
msgstr "Lingue"

msgctxt "#30101"
msgid "Primary Language"
msgstr "Lingua principale"

msgctxt "#30102"
msgid "Secondary Language"
msgstr "Lingua secondaria"

msgctxt "#30103"
msgid "Third Language"
msgstr "Terza lingua"

msgctxt "#29999"
msgid "Fourth Language"
msgstr "Quarta lingua"

msgctxt "#29998"
msgid "Fifth Language"
msgstr "Quinta lingua"

msgctxt "#29997"
msgid "Sixth Language"
msgstr "Sesta lingua"

msgctxt "#30104"
msgid "Audio Preferences"
msgstr "Preferenze audio"

msgctxt "#30105"
msgid "Subtitle Preferences"
msgstr "Preferenze sottotitoli"

msgctxt "#30106"
msgid "Conditional Subtitle Preferences"
msgstr "Preferenze condizionali dei sottotitoli"

msgctxt "#30107"
msgid "Enable Preference"
msgstr "Abilita preferenza"

msgctxt "#30108"
msgid "Enable Language Preference Manager"
msgstr "Abilita Gestore delle preferenze linguistiche"

msgctxt "#30109"
msgid "Pause while evaluating preferences"
msgstr "Pausa durante la valutazione delle preferenze"

msgctxt "#30110"
msgid "If audio language is "
msgstr "Se la lingua audio è "

msgctxt "#30111"
msgid "then display subtitles with language"
msgstr "mostra quindi i sottotitoli nella lingua"

msgctxt "#30112"
msgid "Delay the evaluation by the following value [ms]"
msgstr "Ritarda la valutazione del seguente valore [ms]"

msgctxt "#30113"
msgid "Turn on subtitles if a subtitle matches in any setting globally"
msgstr "Attiva i sottotitoli se un sottotitolo corrisponde a una qualsiasi impostazione globale"

msgctxt "#30114"
msgid "Turn off subtitles if no subtitle preference matched"
msgstr "Disattiva i sottotitoli se nessuna preferenza per i sottotitoli corrisponde"

msgctxt "#30115"
msgid "Advanced/Custom settings"
msgstr "Impostazioni avanzate/personalizzate"

msgctxt "#30116"
msgid "Try to set the audio and/or subtitle track from the filename first"
msgstr "Prova prima a impostare la traccia audio e/o dei sottotitoli dal nome del file"

msgctxt "#30117"
msgid "Regular expression for filename based preferences"
msgstr "Espressione regolare per le preferenze basate sul nome del file"

msgctxt "#30118"
msgid "Use custom pref, e.g. eng>ger>fin :"
msgstr "Usa una preferenza personalizzata, ad es. eng>ger>fin :"

msgctxt "#30119"
msgid "Use custom pref, e.g. eng>ger>fin :"
msgstr "Usa una preferenza personalizzata, ad es. eng>ger>fin :"

msgctxt "#30120"
msgid "Forced"
msgstr "Forzato"

msgctxt "#30121"
msgid "Use custom pref, e.g. jpn:eng>eng:ger :"
msgstr "Usa una preferenza personalizzata, ad es. jpn:eng>eng:ger :"

msgctxt "#30122"
msgid "General"
msgstr "Generale"

msgctxt "#30123"
msgid "Ignore all Signs and Songs subtitles tracks"
msgstr "Ignora tutte le tracce dei sottotitoli per cartelli e canzoni"

msgctxt "#30125"
msgid "Enable Subtitle Keyword Blacklist"
msgstr "Abilita la lista nera delle parole chiave dei sottotitoli"

msgctxt "#30126"
msgid "Enter a comma-separated list of keywords to blacklist in subtitle names"
msgstr "Inserisci un elenco separato da virgole di parole chiave da escludere nei nomi dei sottotitoli"

msgctxt "#30127"
msgid "Subtitle Keyword List:"
msgstr "Elenco parole chiave sottotitoli:"

msgctxt "#30128"
msgid "Enable Audio Keyword Blacklist"
msgstr "Abilita la lista nera delle parole chiave audio"

msgctxt "#30129"
msgid "Enter a comma-separated list of keywords to blacklist in audio names"
msgstr "Inserisci un elenco separato da virgole di parole chiave da escludere nei nomi delle tracce audio"

msgctxt "#30130"
msgid "Audio Keyword List:"
msgstr "Elenco parole chiave audio:"

msgctxt "#30131"
msgid "Fast Subtitles Display:"
msgstr "Visualizzazione rapida dei sottotitoli:"

msgctxt "#30132"
msgid "Disabled"
msgstr "Disabilitato"

msgctxt "#30133"
msgid "New Start only"
msgstr "Solo nuovo avvio"

msgctxt "#30134"
msgid "Start & Resume"
msgstr "Avvio e ripresa"

msgctxt "#30135"
msgid "Stored Preferences"
msgstr "Preferenze salvate"

msgctxt "#30136"
msgid "Store Pref. Movies"
msgstr "Salva preferenze film"

msgctxt "#30137"
msgid "Store Pref. TV Shows"
msgstr "Salva preferenze serie TV"

msgctxt "#30138"
msgid "Changed audio/subt. override config pref. next time for the same movie/series?"
msgstr "Modificare la preferenza di configurazione per la sostituzione audio/sottotitoli la prossima volta per lo stesso film/serie?"

msgctxt "#30139"
msgid "If enabled, manually selected audio/subtitle tracks during playback will be stored and restored next time for the same movie/whole series."
msgstr "Se abilitato, le tracce audio/dei sottotitoli selezionate manualmente durante la riproduzione verranno salvate e ripristinate la prossima volta per lo stesso film/l'intera serie."

msgctxt "#30140"
msgid "Edit Overrides"
msgstr "Modifica sostituzioni"

msgctxt "#30141"
msgid "A new label"
msgstr "Una nuova etichetta"

msgctxt "#30142"
msgid "Enable Audio Original Preferences"
msgstr "Abilita preferenze audio originali"

msgctxt "#30143"
msgid "Enter a comma-separated list of codes (e.g eng,ger,fre)"
msgstr "Inserisci un elenco separato da virgole di codici (ad es. eng,ger,fre)"

msgctxt "#30144"
msgid "Audio Original Preference List:"
msgstr "Elenco preferenze audio originali:"

msgctxt "#30146"
msgid "Use regex pattern to filter subtitles"
msgstr "Usa un modello regex per filtrare i sottotitoli"

msgctxt "#30147"
msgid "Regex pattern for subtitle filtering"
msgstr "Modello regex per il filtro dei sottotitoli"

msgctxt "#30148"
msgid "Regex exclusion pattern for subtitle filtering"
msgstr "Modello regex di esclusione per il filtro dei sottotitoli"

msgctxt "#30149"
msgid "Use regex exclusion pattern to filter out false positives"
msgstr "Usa un modello regex di esclusione per eliminare i falsi positivi"

