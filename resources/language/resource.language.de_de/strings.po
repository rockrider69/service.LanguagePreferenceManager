msgctxt "#30104"
msgid "Audio Preferences"
msgstr "Audioeinstellungen"

msgctxt "#30105"
msgid "Subtitle Preferences"
msgstr "Untertiteleinstellungen"

msgctxt "#30106"
msgid "Conditional Subtitle Preferences"
msgstr "Bedingte Untertiteleinstellungen"

msgctxt "#30107"
msgid "Enable Preference"
msgstr "Einstellung aktivieren"

msgctxt "#30108"
msgid "Enable Language Preference Manager"
msgstr "Sprachpräferenz-Manager aktivieren"

msgctxt "#30109"
msgid "Pause while evaluating preferences"
msgstr "Während der Auswertung der Einstellungen pausieren"

msgctxt "#30110"
msgid "If audio language is "
msgstr "Wenn die Audiosprache "

msgctxt "#30111"
msgid "then display subtitles with language"
msgstr "dann Untertitel in folgender Sprache anzeigen"

msgctxt "#30112"
msgid "Delay the evaluation by the following value [ms]"
msgstr "Auswertung um folgenden Wert verzögern [ms]"

msgctxt "#30113"
msgid "Turn on subtitles if a subtitle matches in any setting globally"
msgstr "Untertitel aktivieren, wenn ein Untertitel global einer Einstellung entspricht"

msgctxt "#30114"
msgid "Turn off subtitles if no subtitle preference matched"
msgstr "Untertitel deaktivieren, wenn keine Untertiteleinstellung übereinstimmt"

msgctxt "#30115"
msgid "Advanced/Custom settings"
msgstr "Erweiterte/Benutzerdefinierte Einstellungen"

msgctxt "#30116"
msgid "Try to set the audio and/or subtitle track from the filename first"
msgstr "Zuerst versuchen, Audio- und/oder Untertitelspur anhand des Dateinamens festzulegen"

msgctxt "#30117"
msgid "Regular expression for filename based preferences"
msgstr "Regulärer Ausdruck für dateinamensbasierte Einstellungen"

msgctxt "#30118"
msgid "Use custom pref, e.g. eng>ger>fin :"
msgstr "Benutzerdefinierte Präferenz verwenden, z. B. eng>ger>fin :"

msgctxt "#30119"
msgid "Use custom pref, e.g. eng>ger>fin :"
msgstr "Benutzerdefinierte Präferenz verwenden, z. B. eng>ger>fin :"

msgctxt "#30120"
msgid "Forced"
msgstr "Erzwungen"

msgctxt "#30121"
msgid "Use custom pref, e.g. jpn:eng>eng:ger :"
msgstr "Benutzerdefinierte Präferenz verwenden, z. B. jpn:eng>eng:ger :"

msgctxt "#30122"
msgid "General"
msgstr "Allgemein"

msgctxt "#30123"
msgid "Ignore all Signs and Songs subtitles tracks"
msgstr "Alle Untertitelspuren für Schilder und Songs ignorieren"

msgctxt "#30125"
msgid "Enable Subtitle Keyword Blacklist"
msgstr "Untertitel-Schlüsselwort-Blacklist aktivieren"

msgctxt "#30126"
msgid "Enter a comma-separated list of keywords to blacklist in subtitle names"
msgstr "Kommagetrennte Liste von Schlüsselwörtern eingeben, die in Untertitelnamen blockiert werden sollen"

msgctxt "#30127"
msgid "Subtitle Keyword List:"
msgstr "Untertitel-Schlüsselwortliste:"

msgctxt "#30128"
msgid "Enable Audio Keyword Blacklist"
msgstr "Audio-Schlüsselwort-Blacklist aktivieren"

msgctxt "#30129"
msgid "Enter a comma-separated list of keywords to blacklist in audio names"
msgstr "Kommagetrennte Liste von Schlüsselwörtern eingeben, die in Audionamen blockiert werden sollen"

msgctxt "#30130"
msgid "Audio Keyword List:"
msgstr "Audio-Schlüsselwortliste:"

msgctxt "#30131"
msgid "Fast Subtitles Display:"
msgstr "Schnelle Untertitelanzeige:"

msgctxt "#30132"
msgid "Disabled"
msgstr "Deaktiviert"

msgctxt "#30133"
msgid "New Start only"
msgstr "Nur bei neuem Start"

msgctxt "#30134"
msgid "Start & Resume"
msgstr "Start & Fortsetzen"

msgctxt "#30135"
msgid "Stored Preferences"
msgstr "Gespeicherte Einstellungen"

msgctxt "#30136"
msgid "Store Pref. Movies"
msgstr "Einstellungen für Filme speichern"

msgctxt "#30137"
msgid "Store Pref. TV Shows"
msgstr "Einstellungen für Serien speichern"

msgctxt "#30138"
msgid "Changed audio/subt. override config pref. next time for the same movie/series?"
msgstr "Geänderte Audio-/Untertitel-Überschreibungseinstellung beim nächsten Mal für denselben Film/dieselbe Serie verwenden?"

msgctxt "#30139"
msgid "If enabled, manually selected audio/subtitle tracks during playback will be stored and restored next time for the same movie/whole series."
msgstr "Wenn aktiviert, werden während der Wiedergabe manuell ausgewählte Audio-/Untertitelspuren gespeichert und beim nächsten Mal für denselben Film/die gesamte Serie wiederhergestellt."

msgctxt "#30140"
msgid "Edit Overrides"
msgstr "Überschreibungen bearbeiten"

msgctxt "#30141"
msgid "A new label"
msgstr "Eine neue Bezeichnung"

msgctxt "#30142"
msgid "Enable Audio Original Preferences"
msgstr "Original-Audioeinstellungen aktivieren"

msgctxt "#30143"
msgid "Enter a comma-separated list of codes (e.g eng,ger,fre)"
msgstr "Kommagetrennte Liste von Codes eingeben (z. B. eng,ger,fre)"

msgctxt "#30144"
msgid "Audio Original Preference List:"
msgstr "Liste der Original-Audioeinstellungen:"

msgctxt "#30146"
msgid "Use regex pattern to filter subtitles"
msgstr "Regex-Muster zum Filtern von Untertiteln verwenden"

msgctxt "#30147"
msgid "Regex pattern for subtitle filtering"
msgstr "Regex-Muster für die Untertitelfilterung"

msgctxt "#30148"
msgid "Regex exclusion pattern for subtitle filtering"
msgstr "Regex-Ausschlussmuster für die Untertitelfilterung"

msgctxt "#30149"
msgid "Use regex exclusion pattern to filter out false positives"
msgstr "Regex-Ausschlussmuster verwenden, um Fehlzuordnungen herauszufiltern"

